<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- Flutter's debug tooling connects over a local socket. -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- Choosing a ledger to import, and saving backups or Excel exports.
	     Without this the file picker silently fails to open. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Default location offered when saving a backup. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>

	<!-- Outbound HTTPS to the Meta WhatsApp Cloud API. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Sending a receipt to a printer from the Print / Save PDF action. -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
