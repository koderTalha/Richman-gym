# macOS
.DS_Store

# Flutter / Dart
**/build/
**/.dart_tool/
**/.packages
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/generated_plugin_registrant.*

# fvm: the pin file (.fvmrc) is committed, the SDK symlink is not
.fvm/flutter_sdk
.fvm/versions

# IDE
.idea/
*.iml
*.iws
.vscode/*
!.vscode/settings.json

# Installer output
dist/

# Local data: never commit a gym's members, payments or receipts.
#
# These are matched by file type and by exact path, NOT by a bare `**/data/`
# pattern — that also matches lib/data/, the source folder holding the database
# layer, and silently leaves it out of the repository.
*.sqlite
*.sqlite-wal
*.sqlite-shm
/rmf_desktop/data/
/rmf_desktop/storage/
